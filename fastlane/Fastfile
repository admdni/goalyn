# Goalyn iOS — Fastlane configuration
#
# Usage:
#   fastlane ios beta             # build & upload to TestFlight
#   fastlane ios release          # full upload + metadata + submit for review
#   fastlane ios upload_metadata  # push App Store metadata only (no binary)
#
# Required env vars (provided by Codemagic or local .env):
#   APP_STORE_CONNECT_API_KEY_KEY_ID
#   APP_STORE_CONNECT_API_KEY_ISSUER_ID
#   APP_STORE_CONNECT_API_KEY_KEY     (the .p8 file contents, single line, \n-escaped)
# OR
#   APP_STORE_CONNECT_API_KEY_PATH    (path to the .p8 on disk)

default_platform(:ios)

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Load App Store Connect API key from env (Codemagic) or local p8 file"
  private_lane :load_api_key do
    key_id     = ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"]     || "249G24VRT6"
    issuer_id  = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]  || "05481e43-1010-4891-b4ec-68befd43ade4"

    key_content = ENV["APP_STORE_CONNECT_API_KEY_KEY"]
    key_path    = ENV["APP_STORE_CONNECT_API_KEY_PATH"]

    options = {
      key_id:      key_id,
      issuer_id:   issuer_id,
      duration:    1200,
      in_house:    false,
    }

    if key_content && !key_content.empty?
      options[:key_content] = key_content
      options[:is_key_content_base64] = false
    elsif key_path && File.exist?(key_path)
      options[:key_filepath] = key_path
    else
      local = File.expand_path("../AuthKey_#{key_id}.p8", __dir__)
      raise "App Store Connect p8 not found at #{local}" unless File.exist?(local)
      options[:key_filepath] = local
    end

    app_store_connect_api_key(options)
  end

  desc "Ensure a distribution certificate + App Store provisioning profile exist locally"
  lane :setup_signing do
    api_key = load_api_key
    # Pull or create the App Store distribution certificate.
    cert(
      api_key: api_key,
      development: false,
      output_path: "./fastlane/certs",
    )
    # Pull or create the App Store provisioning profile for our bundle id.
    sigh(
      api_key: api_key,
      app_identifier: "com.tanaltay.goalyn",
      platform: "ios",
      output_path: "./fastlane/profiles",
    )
  end

  desc "Build a signed Flutter iOS release IPA"
  private_lane :build_flutter_ipa do
    setup_signing
    sh("cd .. && flutter clean && flutter pub get")
    sh("cd .. && flutter build ipa --release --export-options-plist=ios/ExportOptions.plist || flutter build ipa --release")
  end

  desc "Upload TestFlight build (binary only, no metadata)"
  lane :beta do
    api_key = load_api_key
    build_flutter_ipa
    pilot(
      api_key: api_key,
      ipa: "../build/ios/ipa/goalyn.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      changelog: "Pre-release build for internal testing.",
    )
  end

  desc "Push App Store metadata + screenshots without uploading a binary"
  lane :upload_metadata do
    api_key = load_api_key
    deliver(
      api_key: api_key,
      submit_for_review: false,
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      skip_app_version_update: true,
      precheck_include_in_app_purchases: false,
      languages: ["en-US", "zh-Hant", "zh-Hans"],
      run_precheck_before_submit: false,
    )
  end

  desc "Push App Store screenshots only (separate from text metadata)"
  lane :upload_screenshots do
    api_key = load_api_key
    deliver(
      api_key: api_key,
      submit_for_review: false,
      force: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      skip_app_version_update: true,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      # zh-Hant is the app's primary language, so screenshots must live there.
      languages: ["zh-Hant"],
      run_precheck_before_submit: false,
    )
  end

  desc "Full release: build, upload binary, push metadata, submit for review"
  lane :release do
    api_key = load_api_key
    build_flutter_ipa
    deliver(
      api_key: api_key,
      ipa: "../build/ios/ipa/goalyn.ipa",
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_screenshots: true,
      skip_metadata: false,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        export_compliance_encryption_updated: false,
      },
      languages: ["zh-Hant", "zh-Hans"],
    )
  end
end
